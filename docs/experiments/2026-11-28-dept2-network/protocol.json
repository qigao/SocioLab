{
  "schema": "sociolab.archive-network-comparison-protocol.v1",
  "study_id": "email-eu-dept2-frozen-network-recurrence-v1",
  "source": {
    "dataset": "SNAP email-Eu-core-temporal-Dept2",
    "source_url": "https://snap.stanford.edu/data/email-Eu-core-temporal.html",
    "download_url": "https://snap.stanford.edu/data/email-Eu-core-temporal-Dept2.txt.gz",
    "paper_doi": "https://doi.org/10.1145/3018661.3018731",
    "advertised_nodes": 162,
    "advertised_temporal_rows": 46772,
    "advertised_static_pairs": 1772,
    "advertised_span_days": 803,
    "selection_basis": "lowest_numbered_unread_department_within_existing_200_node_2000_pair_budgets_Dept1_exceeds_both",
    "previously_examined_source": "Dept3_results_in_PR29_informed_this_design",
    "independence": "new_departmental_file_from_same_institutional_release_not_independent_external_replication"
  },
  "measurement": {
    "target": "at_least_one_matching_row_in_fixed_released_archive_target_window",
    "negative": "no_matching_archive_row_not_verified_real_communication_absence",
    "time_unit": "source_relative_seconds",
    "seconds_per_day": 86400,
    "source_zero_shifted": false,
    "history_start": 0,
    "training_origins": [7776000, 15552000],
    "fit_cutoff": 23328000,
    "validation_origins": [23328000],
    "test_origins": [31104000, 38880000, 46656000, 54432000],
    "horizon": 7776000,
    "recent_width": 2592000,
    "window_boundary": "left_closed_right_open",
    "risk_set": "each_origin_history_positive_ordered_nonself_pairs",
    "population": "historical_archive_endpoints_no_future_activity_or_full_roster_filter",
    "self_pair_policy": "retain_in_source_audit_exclude_from_features_risk_and_labels",
    "duplicate_policy": "retain_every_physical_row_in_counts_no_message_identity_inferred",
    "tied_time_policy": "unordered_counts_no_jitter_or_invented_sequence",
    "source_line_order_is_receipt_order": false,
    "denominator": "archive_window_duration_not_verified_person_exposure",
    "missingness": "archive_defined_labels_only_no_real_coverage_or_membership_imputation"
  },
  "features": {
    "graph": "NetworkX_DiGraph_binary_nonself_edges_from_history_only",
    "dyadic": [
      "log1p_history_expected_count",
      "log1p_recent_expected_count",
      "log1p_last_record_age_horizons"
    ],
    "network_additions": [
      "log1p_reverse_history_expected_count",
      "log1p_reverse_recent_expected_count",
      "log1p_source_out_degree",
      "log1p_target_in_degree",
      "log1p_directed_two_step_paths"
    ],
    "history_expected_count": "history_pair_count*horizon/origin",
    "recent_expected_count": "recent_pair_count*horizon/recent_width",
    "last_record_age_horizons": "(origin-max_historical_pair_time)/horizon",
    "reverse_rates": "same_rate_formulas_for_opposite_ordered_pair_zero_if_no_released_historical_row",
    "degrees": "source_binary_out_degree_and_target_binary_in_degree",
    "two_step_paths": "number_of_distinct_k_with_source_to_k_and_k_to_target_excluding_both_endpoints",
    "transform": "natural_log1p_of_each_declared_nonnegative_quantity",
    "nonfinite_policy": "reject_before_upstream_scaling_no_imputation",
    "identifiers_as_predictors": false
  },
  "estimation": {
    "provider": "scikit-learn",
    "provider_version": "1.9.1",
    "upstream_commit": "866c0f51e7560ef0303cbcc5f159df5382ea9e3f",
    "estimator": "sklearn.linear_model.LogisticRegression",
    "scaler": "sklearn.preprocessing.StandardScaler",
    "scaler_parameters": {"with_mean": true, "with_std": true},
    "parameters": {
      "solver": "lbfgs", "l1_ratio": 0.0, "C": 1.0,
      "tol": 1e-8, "max_iter": 1000, "fit_intercept": true,
      "class_weight": null, "warm_start": false
    },
    "fit_rule": "once_per_declared_feature_block_using_training_pair_origin_rows_only",
    "sample_weight": "one_per_training_pair_origin_no_class_reweighting_or_resampling",
    "scaling_fit": "training_features_only",
    "labels": [0, 1],
    "probability_column": "class_1_only_after_asserting_exact_classes_0_1",
    "validation_use": "diagnostics_only_no_selection_tuning_or_refit",
    "test_updates": "history_features_may_advance_but_scaler_and_model_parameters_stay_frozen",
    "failed_fit_policy": "empty_or_single_class_training_nonfinite_or_warning_bearing_fit_remains_failed_with_null_scores_no_fallback",
    "model_selection_or_tuning": false,
    "calibrator_fitted": false,
    "thread_limit": 1
  },
  "analysis": {
    "models": ["historical_poisson", "recent_poisson", "recent_occurrence", "training_prevalence", "dyadic_logistic", "network_logistic"],
    "reference": "always_zero_brier_equals_archive_positive_fraction",
    "training_prevalence": "pooled_training_positive_fraction_frozen_at_fit_cutoff",
    "probability_bins": [0, 0.2, 0.4, 0.6, 0.8, 1],
    "primary_comparison": "test_pooled_network_logistic_brier_minus_dyadic_logistic_brier",
    "additional_comparisons": "test_pooled_each_successful_model_against_shared_baselines_and_zero_reference",
    "secondary_metric": "test_equal_origin_macro_brier_null_unless_all_planned_test_origins_have_scored_pairs",
    "validation_and_test_aggregated_separately": true,
    "empty_targets": "retain_all_planned_windows_and_report_all_archive_row_counts",
    "failed_models": "retain_planned_model_slots_and_failed_coverage_without_model_selection",
    "confidence_intervals": false,
    "dependent_pair_origins_treated_as_iid": false
  },
  "admission": {
    "required_rows": 46772, "required_nodes": 162,
    "maximum_nodes": 200, "maximum_nonself_pairs": 2000,
    "maximum_rows": 100000, "maximum_compressed_bytes": 2000000,
    "maximum_decompressed_bytes": 8000000,
    "minimum_archive_max_time": 62208000,
    "fingerprints": "bind_full_compressed_and_payload_sha256_after_acquisition_before_estimation",
    "malformed_or_metadata_mismatch": "stop_without_retuning_or_silent_row_dropping",
    "static_pair_metadata": "audit_not_assume_self_loop_convention",
    "extent_check_meaning": "artifact_sanity_not_real_followup_closure"
  },
  "scope": {
    "analysis": "source_time_temporal_holdout_of_released_record_recurrence",
    "strict_complete_observation_r1_admitted": false,
    "real_communication_coverage_complete": null,
    "historical_receipt_availability_verified": false,
    "prospective_issuance_verified": false,
    "independent_institution_replication": false,
    "exact_time_rem_or_waiting_time_likelihood": false,
    "relationship_termination_inferred": false,
    "motivation_or_language_validated": false,
    "causal_effect_identified": false,
    "calibration_validated": false,
    "upstream_numerical_solver_reimplemented": false,
    "dataset_specific_license": "not_stated_on_reviewed_official_pages_no_raw_redistribution",
    "raw_source_or_private_pair_forecasts_published": false
  },
  "execution": {
    "protocol_frozen_before_raw_dept2_acquisition": true,
    "fit_before_validation_or_test_target_scoring": true,
    "frozen_parameter_hash_checked_at_every_prediction_origin": true,
    "batch_replay_parity": "same_historical_rows_and_timestamp_groups_with_empty_time_advances_no_live_subscriber_claim",
    "independent_check": "standard_library_counts_features_and_saved_parameter_probability_score_oracle_no_sklearn_refit",
    "native_tests": "existing_suite_plus_leakage_failure_feature_and_replay_boundaries",
    "outputs": "aggregate_audit_training_fit_parameters_per_origin_scores_bins_hashes_and_execution_evidence"
  }
}
